# Groq API (free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_your-key-here

# LLM Model (from Groq - openai/gpt-oss-20b is active and free)
MODEL_NAME=openai/gpt-oss-20b

# Embeddings Model (from HuggingFace - free, runs locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval tuning
RETRIEVAL_K=4                 # Top-K policy chunks to retrieve per question
MAX_COMPLIANCE_RETRIES=2      # Max retries before escalating to human review
